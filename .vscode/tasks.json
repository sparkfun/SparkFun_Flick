{
    // Ctrl+Shift+B runs the default build task: build the sketch whose file is
    // open in the editor, upload it to the Baseline already on the board, and
    // show its serial output. Pressing it again stops the monitor and re-uploads.
    // The other tasks are in Terminal > Run Task.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Sketch: build + upload + monitor",
            "type": "process",
            "command": "python",
            "args": ["${workspaceFolder}/flick.py", "upload", "${fileDirname}", "--monitor"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": { "base": "$gcc", "fileLocation": "absolute" },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "runOptions": { "instanceLimit": 1, "instancePolicy": "terminateOldest" }
        },
        {
            "label": "Sketch: build only",
            "type": "process",
            "command": "python",
            "args": ["${workspaceFolder}/flick.py", "build", "${fileDirname}"],
            "group": "build",
            "problemMatcher": { "base": "$gcc", "fileLocation": "absolute" },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "New sketch",
            "type": "process",
            "command": "python",
            "args": ["${workspaceFolder}/flick.py", "new", "${input:sketchName}"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Set WiFi network",
            "type": "process",
            "command": "python",
            "args": ["${workspaceFolder}/flick.py", "wifi", "${input:wifiName}", "${input:wifiPassword}"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Serial monitor",
            "type": "process",
            "command": "python",
            "args": ["${workspaceFolder}/flick.py", "monitor"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Setup: install the compiler (once)",
            "type": "process",
            "command": "python",
            "args": ["${workspaceFolder}/flick.py", "setup"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Baseline: reboot into safe mode",
            "type": "process",
            "command": "python",
            "args": ["${workspaceFolder}/flick.py", "safe"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        }
    ],
    "inputs": [
        {
            "id": "wifiName",
            "type": "promptString",
            "description": "WiFi network name, for sketches that use WIFI_SSID (saved in ~/.flick/secrets.cfg, never in your sketch)"
        },
        {
            "id": "wifiPassword",
            "type": "promptString",
            "password": true,
            "description": "WiFi password (saved in ~/.flick/secrets.cfg)"
        },
        {
            "id": "sketchName",
            "type": "promptString",
            "description": "Name of the new sketch (letters, digits and _); it goes in my_sketches/"
        }
    ]
}
