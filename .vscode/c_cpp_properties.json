{
    "configurations": [
        {
            "name": "Baseline sketch (ESP32-S3)",
            "compilerPath": "${env:LOCALAPPDATA}/Arduino15/packages/esp32/tools/esp-x32/2601/bin/xtensa-esp32s3-elf-gcc.exe",
            "includePath": [
                "${workspaceFolder}/sdk/include",
                "${workspaceFolder}/sdk/include/compat"
            ],
            "forcedInclude": [
                "${workspaceFolder}/sdk/include/baseline.h"
            ],
            "cStandard": "gnu17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "gcc-x86"
        }
    ],
    "version": 4
}
