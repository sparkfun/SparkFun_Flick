# Classic ESP32 settings, on top of idf/sdkconfig.defaults (each product
# target can add its own in targets/<target>/idf/sdkconfig.defaults).

# ESP32 rev 3.0 or later only (ESP32-D0WD-V3, WROOM-32E, WROVER-E, PICO-V3...).
# Earlier chips need the PSRAM cache workaround, which keeps most of newlib in
# IRAM instead of ROM; dropping them frees that IRAM.
CONFIG_ESP32_REV_MIN_3=y

# Move FreeRTOS and heap functions that are not needed with the cache disabled
# or in ISRs from IRAM to flash.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y

# Flash size: from the target's flash_size (bsk adds CONFIG_ESPTOOLPY_FLASHSIZE_*).

# Internal RAM: Bluedroid init takes ~82 KB and left too little for WiFi, so
# BLE + WiFi together ran out of memory. With PSRAM on the board, let WiFi/lwIP
# buffers and Bluedroid allocate there first; without PSRAM these fall back to
# internal RAM as before.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y

# Bluetooth Classic: Baseline only uses SPP (BluetoothSerial). Leave out the
# audio (A2DP, AVRCP) and hands-free (HFP) profiles Arduino's base enables.
# CONFIG_BT_A2DP_ENABLE is not set
# CONFIG_BT_HFP_ENABLE is not set

# Console at 921600 baud (BL_PORT_CONSOLE_BAUD in bl_port.h); the bootloader's
# messages match it. Only the ROM's first lines remain at 115200.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
