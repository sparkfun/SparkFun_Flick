# iot_redboard_esp32, on top of the chip's sdkconfig.defaults.
# Arduino's pin variant for this board (pins_arduino.h). Baseline itself takes its
# default pins from sdk/bl_board.h; this keeps the Arduino core's own constants
# (LED_BUILTIN, RGB_BUILTIN, ...) consistent with them.
CONFIG_ARDUINO_VARIANT="sparkfun_esp32_iot_redboard"

# No PSRAM on this board: allocate WiFi TX buffers as frames are sent, instead
# of 16 fixed 1.6 KB buffers in internal RAM (the chip defaults assume PSRAM).
# This leaves room for Bluedroid next to WiFi.
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6

# Task stacks Arduino enlarges to 8 KB for callback-heavy sketches. Baseline's
# BLE callbacks only queue events, so smaller stacks do (IDF defaults: BTC 3 KB,
# BTU 4.25 KB, timer task 2 KB). Together with the TX buffers above, this leaves
# room for a BLE scan while WiFi is connected.
CONFIG_BT_BTC_TASK_STACK_SIZE=6144
CONFIG_BT_BTU_TASK_STACK_SIZE=4352
CONFIG_TIMER_TASK_STACK_SIZE=4096
