# Classic ESP32 settings, on top of idf/sdkconfig.defaults (each product
# target can add its own in targets/<target>/idf/sdkconfig.defaults).

# ESP32 rev 3.0 or later only (ESP32-D0WD-V3, WROOM-32E, WROVER-E, PICO-V3...).
# Earlier chips need the PSRAM cache workaround, which keeps most of newlib in
# IRAM instead of ROM; dropping them frees that IRAM.
CONFIG_ESP32_REV_MIN_3=y

# Move FreeRTOS and heap functions that are not needed with the cache disabled
# or in ISRs from IRAM to flash.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y

# Flash size: from the target's flash_size (flick adds CONFIG_ESPTOOLPY_FLASHSIZE_*).

# Internal RAM: Bluedroid init takes ~82 KB and left too little for WiFi, so
# BLE + WiFi together ran out of memory. With PSRAM on the board, let WiFi/lwIP
# buffers and Bluedroid allocate there first; without PSRAM these fall back to
# internal RAM as before.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y

# With SPIRAM_TRY_ALLOCATE_WIFI_LWIP, ESP-IDF requires static WiFi TX buffers,
# 1.6 KB each in internal RAM while WiFi is on. 8 instead of 16 (~13 KB back):
# frames beyond them wait in the 32 cache TX buffers, which are in PSRAM.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8

# Task stacks Arduino enlarges to 8 KB for callback-heavy sketches. Baseline's
# Bluetooth and timer callbacks only queue events for the sketch task, so
# smaller stacks do (IDF defaults: BTC 3 KB, BTU 4.25 KB, esp_timer 3.5 KB,
# timer service 2 KB). With the TX buffers above this leaves room for Bluetooth
# Classic, BLE and WiFi at once.
CONFIG_BT_BTC_TASK_STACK_SIZE=6144
CONFIG_BT_BTU_TASK_STACK_SIZE=4352
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_TIMER_TASK_STACK_SIZE=4096

# Bluetooth Classic: Baseline only uses SPP (BluetoothSerial). Leave out the
# audio (A2DP, AVRCP) and hands-free (HFP) profiles Arduino's base enables.
# CONFIG_BT_A2DP_ENABLE is not set
# CONFIG_BT_HFP_ENABLE is not set

# Baseline's console runs at 115200, like the ROM and bootloader messages, and
# rises to 921600 only during an upload (BL_PORT_CONSOLE_BAUD and the loader's
# BAUD command; bl_port.h says why). IDF applies this line only with
# CONFIG_ESP_CONSOLE_UART_CUSTOM, so it just records the rate.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Keep the UART interrupt running while flash is written (the cache is off then).
# An upload sends several lines before waiting for replies (loader BAUD
# window=); without this the 128-byte UART FIFO overflows during each flash
# write at 921600 and a line is lost. Costs a little IRAM (about 25 KB free).
CONFIG_UART_ISR_IN_IRAM=y
