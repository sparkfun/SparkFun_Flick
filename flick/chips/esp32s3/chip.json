{
    "description": "ESP32-S3",
    "baseline_source": "baseline",
    "builder": "idf",
    "idf_version": "5.5",
    "idf_target": "esp32s3",
    "idf_defines": [
        "ARDUINO_USB_MODE=1",
        "ARDUINO_USB_CDC_ON_BOOT=1"
    ],
    "idf_defines_note": "Baseline's console is the native USB port: what the Arduino IDE's USBMode=default (Hardware CDC and JTAG) and CDCOnBoot=cdc options define.",
    "idf_prebuilt_components": [
        "arduino_tinyusb"
    ],
    "min_core": "3.3.0",
    "gcc": "xtensa-esp32s3-elf-gcc",
    "cflags": [
        "-mlongcalls"
    ],
    "ldflags": [
        "-mlongcalls"
    ],
    "linker_script": "sdk/ld/sketch_esp.ld.in",
    "sdk_sources": [],
    "usb_vids": [
        "303A"
    ]
}
